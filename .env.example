# 构建设置，都不提交，都可以留空（说明见 scripts/tauri.mjs 开头）
# - .env：几台机器共用，复制本文件成 .env 再填；有 age 密钥的机器用 pnpm env:open 从 secrets/env.sops.yaml 解出
# - .env.local：只属于这台机器，不加密、不共享，写法一样，优先于 .env；shell 里 export 的同名变量再优先

# 频道配置（ntfy 发现用），构建时写进程序
FOX_SYNC_DEFAULT_SERVER=
FOX_SYNC_DEFAULT_TOPIC=
FOX_SYNC_DEFAULT_TOKEN=
FOX_SYNC_DEFAULT_KEY=

# crates 镜像，比如 sparse+https://rsproxy.cn/index/
FOX_SYNC_CARGO_MIRROR=

# 签名身份，每台机器不同，放 .env.local：比如自己建的自签名代码签名证书的名字
# 留空时有 Apple Development 证书就用它，没有就临时签名
# APPLE_SIGNING_IDENTITY=
