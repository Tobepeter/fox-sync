{
  "name": "fox-sync",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "node scripts/syncthing-bin.mjs && node scripts/tauri.mjs dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "node scripts/syncthing-bin.mjs && node scripts/tauri.mjs build --bundles app && node scripts/check-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "types": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml && node --test tests/*.test.ts",
    "test:web": "node --test tests/*.test.ts",
    "probe": "node scripts/probe.mjs",
    "format": "prettier --write src scripts tests",
    "tauri": "tauri",
    "install:app": "pnpm build:desktop && node scripts/install-app.mjs",
    "env:seal": "scripts/env.sh seal",
    "env:open": "scripts/env.sh open",
    "env:check": "scripts/env.sh check",
    "build:debug-app": "node scripts/syncthing-bin.mjs && node scripts/tauri.mjs build --debug --bundles app && open src-tauri/target/debug/bundle/macos/FoxSync.app",
    "syncthing:bin": "node scripts/syncthing-bin.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dicebear/collection": "^9",
    "@dicebear/core": "^9.4.3",
    "@tauri-apps/api": "~2.12.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "wouter": "3.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "motion": "14.14.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
